  "components": {
    "schemas": {
      "ArticleDto": {
        "type": "object",
        "required": [
          "id",
          "feedId",
          "title",
          "language",
          "link",
          "status",
          "fetchedAt",
          "contentHash"
        ],
        "properties": {
          "contentHash": {
            "type": "string"
          },
          "feedDescription": {
            "type": [
              "string",
              "null"
            ]
          },
          "feedId": {
            "type": "string",
            "format": "uuid"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "htmlContent": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "language": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/ArticleStatusDto"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "ArticleStatusDto": {
        "type": "string",
        "enum": [
          "pending",
          "extracted",
          "extractionFailed",
          "done"
        ]
      },
      "ArticleWithDataDto": {
        "type": "object",
        "required": [
          "article"
        ],
        "properties": {
          "article": {
            "$ref": "#/components/schemas/ArticleDto"
          },
          "categoryId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "sentimentScore": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        }
      },
      "CategoryDto": {
        "type": "object",
        "required": [
          "humanName",
          "humanDescription",
          "modelDescription"
        ],
        "properties": {
          "humanDescription": {
            "type": "string"
          },
          "humanName": {
            "type": "string"
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "modelDescription": {
            "type": "string"
          }
        }
      },
      "ConsumerStats": {
        "type": "object",
        "required": [
          "name",
          "pending",
          "ack_pending",
